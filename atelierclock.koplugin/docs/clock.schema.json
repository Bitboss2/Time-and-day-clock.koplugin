{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier Clock package v1/v2",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "coordinate": {
      "type": "number",
      "minimum": -3000,
      "maximum": 3000
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3000
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "image",
            "hands",
            "progress",
            "rule",
            "words",
            "stack",
            "dual"
          ]
        },
        "source": {
          "enum": [
            "time",
            "date",
            "battery",
            "wifi",
            "memory",
            "world",
            "ampm",
            "label"
          ]
        },
        "asset": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 256
        },
        "font": {
          "enum": [
            "cfont",
            "tfont",
            "ffont"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "grey": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        },
        "z": {
          "$ref": "#/$defs/coordinate"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "width": {
          "$ref": "#/$defs/coordinate"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "asset"
            ]
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "exclusiveMinimum": 0.02,
          "maximum": 1
        },
        {
          "type": "number",
          "exclusiveMinimum": 0.02,
          "maximum": 1
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "v1": {
      "title": "Atelier Clock package manifest v1",
      "type": "object",
      "required": [
        "format",
        "schema_version",
        "id",
        "name",
        "author",
        "license",
        "canvas",
        "preview",
        "assets",
        "layers"
      ],
      "properties": {
        "format": {
          "const": "atelier-clock"
        },
        "schema_version": {
          "const": 1
        },
        "engine_min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 99
        },
        "subtitle": {
          "type": "string",
          "maxLength": 149
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "order": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "canvas": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000
            },
            "height": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000
            }
          }
        },
        "orientations": {
          "type": "array",
          "items": {
            "enum": [
              "portrait",
              "landscape"
            ]
          },
          "uniqueItems": true
        },
        "preview": {
          "type": "string",
          "pattern": "\\.png$"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "\\.png$"
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "v2": {
      "type": "object",
      "required": [
        "format",
        "schema_version",
        "engine_min",
        "id",
        "name",
        "author",
        "license",
        "canvas",
        "preview",
        "assets",
        "styles",
        "slots",
        "layouts"
      ],
      "properties": {
        "format": {
          "const": "atelier-clock"
        },
        "engine_min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 99
        },
        "subtitle": {
          "type": "string",
          "maxLength": 149
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "order": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "canvas": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000
            },
            "height": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000
            }
          }
        },
        "orientations": {
          "type": "array",
          "items": {
            "enum": [
              "portrait",
              "landscape"
            ]
          },
          "uniqueItems": true
        },
        "preview": {
          "type": "string",
          "pattern": "\\.png$"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "\\.png$"
          }
        },
        "schema_version": {
          "const": 2
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "plein",
              "fin",
              "contour"
            ]
          }
        },
        "texture": {
          "type": "string"
        },
        "texture_landscape": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "family",
              "default",
              "allowed"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/name"
              },
              "label": {
                "type": "string",
                "maxLength": 79
              },
              "family": {
                "enum": [
                  "inline",
                  "circle",
                  "rect",
                  "large"
                ]
              },
              "default": {
                "enum": [
                  "none",
                  "date",
                  "battery",
                  "day",
                  "week",
                  "world",
                  "book"
                ]
              },
              "allowed": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "none",
                    "date",
                    "battery",
                    "day",
                    "week",
                    "world",
                    "book"
                  ]
                }
              }
            }
          }
        },
        "layouts": {
          "type": "object",
          "required": [
            "portrait",
            "landscape"
          ],
          "properties": {
            "portrait": {
              "type": "object",
              "required": [
                "blocks",
                "slots"
              ],
              "properties": {
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type",
                      "box"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/name"
                      },
                      "type": {
                        "enum": [
                          "digits",
                          "analog",
                          "calendar",
                          "words",
                          "timeline",
                          "segments",
                          "label"
                        ]
                      },
                      "box": {
                        "$ref": "#/$defs/rect"
                      },
                      "part": {
                        "enum": [
                          "hour",
                          "minute",
                          "time"
                        ]
                      },
                      "design": {
                        "enum": [
                          "baton",
                          "sector",
                          "cardinal"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "invert": {
                        "type": "boolean"
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "label"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "text"
                          ]
                        }
                      }
                    ]
                  }
                },
                "slots": {
                  "type": "object",
                  "maxProperties": 6,
                  "additionalProperties": {
                    "$ref": "#/$defs/rect"
                  }
                }
              }
            },
            "landscape": {
              "type": "object",
              "required": [
                "blocks",
                "slots"
              ],
              "properties": {
                "blocks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 24,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type",
                      "box"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/name"
                      },
                      "type": {
                        "enum": [
                          "digits",
                          "analog",
                          "calendar",
                          "words",
                          "timeline",
                          "segments",
                          "label"
                        ]
                      },
                      "box": {
                        "$ref": "#/$defs/rect"
                      },
                      "part": {
                        "enum": [
                          "hour",
                          "minute",
                          "time"
                        ]
                      },
                      "design": {
                        "enum": [
                          "baton",
                          "sector",
                          "cardinal"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "invert": {
                        "type": "boolean"
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "label"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "text"
                          ]
                        }
                      }
                    ]
                  }
                },
                "slots": {
                  "type": "object",
                  "maxProperties": 6,
                  "additionalProperties": {
                    "$ref": "#/$defs/rect"
                  }
                }
              }
            }
          }
        },
        "preset": {
          "type": "object",
          "required": [
            "style",
            "appearance",
            "slots"
          ],
          "properties": {
            "style": {
              "enum": [
                "plein",
                "fin",
                "contour"
              ]
            },
            "appearance": {
              "enum": [
                "follow",
                "paper",
                "ink"
              ]
            },
            "slots": {
              "type": "object",
              "maxProperties": 6,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "provider",
                  "zone"
                ],
                "properties": {
                  "provider": {
                    "enum": [
                      "none",
                      "date",
                      "battery",
                      "day",
                      "week",
                      "world",
                      "book"
                    ]
                  },
                  "zone": {
                    "enum": [
                      "UTC",
                      "Europe/Paris",
                      "Europe/London",
                      "America/New_York",
                      "Asia/Tokyo"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
